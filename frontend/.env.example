# OneStopJustice Frontend Environment Variables

# Backend API Configuration
# Base URL for the backend server (without /api suffix)
# For local development: leave empty to use Vite proxy (recommended)
# For production: set to your domain or server URL
VITE_API_BASE_URL=

# IPFS Gateway Configuration
# URL for accessing IPFS files (without hash)
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs

# Development/Production Environment
VITE_NODE_ENV=development

# Note: In local development, the Vite proxy automatically routes 
# /api requests to http://localhost:3001 (backend server)
# No need to set VITE_API_BASE_URL unless you want to override this behavior
